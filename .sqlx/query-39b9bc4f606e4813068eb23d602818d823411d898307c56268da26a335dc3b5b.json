{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.thread_id, m.subject, m.from_addr, m.sent_at, m.received_at, m.size FROM mailbox_messages mm JOIN messages m ON m.id = mm.message_id AND m.tenant_id = mm.tenant_id WHERE mm.tenant_id = $1 AND mm.mailbox_id = $2 AND m.user_id = $3 ORDER BY mm.added_at DESC LIMIT $4 OFFSET $5",
