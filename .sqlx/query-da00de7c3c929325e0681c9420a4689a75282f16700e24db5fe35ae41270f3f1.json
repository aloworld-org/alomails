{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.subject, m.from_addr, m.received_at, m.size, COALESCE(m.has_attachment, false) AS \"has_attachment!: bool\", EXISTS ( SELECT 1 FROM message_keywords k WHERE k.tenant_id = m.tenant_id AND k.message_id = m.id AND k.keyword = $6 ) AS \"seen!: bool\" FROM mailbox_messages mm JOIN messages m ON m.id = mm.message_id AND m.tenant_id = mm.tenant_id WHERE mm.tenant_id = $1 AND mm.mailbox_id = $2 AND m.user_id = $3 ORDER BY mm.added_at DESC LIMIT $4 OFFSET $5",
