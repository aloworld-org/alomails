# alo single-server production config. Copy to `.env` and fill in.
# `.env` is gitignored — real secrets never enter the repo (CLAUDE.md law 1).
# Run ./generate-secrets.sh to fill the secret values for you.

# --- The domain this server IS ---------------------------------------------
# The mail host and HTTPS origin, e.g. mail.example.com. This is the name on
# the TLS certificate, the OIDC issuer, and the SMTP/IMAP hostname. DNS: an
# A/AAAA record for it must point at this server, plus an MX for the mail
# domain and a PTR (reverse DNS) matching this host.
DOMAIN=mail.example.com

# The mail domain(s) this server accepts mail for (comma-separated), e.g.
# example.com. Addresses at these domains are "local"; everything else is
# relayed only for authenticated senders. Required (anti-open-relay).
ALO_SMTP_LOCAL_DOMAINS=example.com

# Email for Let's Encrypt expiry notices (ACME account).
ACME_EMAIL=admin@example.com

# --- Personal signup (ADR 0018) --------------------------------------------
# Domains open to self-service personal signup (comma-separated). Empty
# disables the /signup surface entirely. Set to your platform mail domain to
# let anyone register an address (e.g. johnsmith@alomails.com) — verification-
# gated. Leave empty for a private/B2B server.
ALO_PERSONAL_DOMAINS=

# --- Secrets (fill via ./generate-secrets.sh) ------------------------------
POSTGRES_USER=alo
POSTGRES_PASSWORD=
POSTGRES_DB=alo

# --- Outbound sending ------------------------------------------------------
# On by default in production. Leave SMARTHOST empty to deliver directly by
# MX; set host:port to relay through a smarthost instead.
ALO_SMTP_OUTBOUND_ENABLED=true
ALO_SMTP_SMARTHOST=

# --- DKIM signing (fill via ./generate-dkim.sh) ----------------------------
# All three must be set together. The key lives in ./dkim (mounted read-only)
# and must be PKCS#8 PEM, not group/world-readable. Publish the printed DNS
# record at <selector>._domainkey.<mail-domain>.
ALO_SMTP_DKIM_DOMAIN=example.com
ALO_SMTP_DKIM_SELECTOR=fic
ALO_SMTP_DKIM_KEY=/dkim/dkim.key
ALO_SMTP_DKIM_ALGORITHM=rsa

# --- Logging ---------------------------------------------------------------
RUST_LOG=info

# ---------------------------------------------------------------------------
# LOCAL TEST MODE (no public domain / no Let's Encrypt): uncomment these to
# run the stack with self-signed certs. Do NOT use in production.
#   ALO_SMTP_ALLOW_SELF_SIGNED=true
#   ALO_IMAP_ALLOW_SELF_SIGNED=true
#   ALO_SMTP_TLS_CERT=
#   ALO_SMTP_TLS_KEY=
#   ALO_IMAP_TLS_CERT=
#   ALO_IMAP_TLS_KEY=
# ...and see README.md for the Caddy `tls internal` override.

# Service group id (matches the pinned container uid/gid; cert files are made
# group-readable to it). Keep 10001 unless you rebuilt the images with another.
ALO_GID=10001

# Native Outlook over MAPI-over-HTTP (ADR 0051). Unset or empty leaves it off,
# which is the safe default: `/mapi/*` is absent from the router and
# Autodiscover says nothing about it, so Outlook configures itself over IMAP as
# it does today.
#
# Set to 1 to serve it. Autodiscover then answers a MAPI-capable Outlook with a
# `mapiHttp` block — and an Outlook told to speak MAPI/HTTP does **not** fall
# back to IMAP if the endpoint disappoints it. Other clients are unaffected:
# they never ask for it.
ALO_MAPI_HTTP_ENABLED=
