# alo monitor configuration. Copy to /root/.config/alo/monitor.env on
# the server (chmod 600) and fill in real values. NEVER commit the real file:
# it holds a mailbox password (CLAUDE.md law 1 — no secrets in the repo).
#
# The monitor sends alerts by logging in to the server's own submission port
# as a real mailbox and emailing ALERT_TO. Use a dedicated low-value mailbox
# if you prefer not to reuse a personal account's credentials.

ALERT_TO=you@example.com               # where alerts are delivered (e.g. a phone-checked inbox)
ALERT_FROM=alerts@your-domain.com      # From: address on alert mail
ALERT_USER=alerts@your-domain.com      # mailbox used to send (submission login)
ALERT_PASS=CHANGE_ME                    # that mailbox's password
ALERT_HOST=mail.your-domain.com        # the server's mail hostname (submission on 465)

# Thresholds (sensible defaults; tune per host).
DISK_PCT=80                             # alert when root disk >= this percent
CERT_DAYS=14                            # alert when TLS cert expires within this many days
BACKUP_MAX_HOURS=26                     # alert when newest backup is older than this
FAILED_LOGIN_THRESHOLD=15               # alert when failed logins in the window exceed this
FAILED_LOGIN_WINDOW_MIN=15              # the failed-login counting window, minutes
