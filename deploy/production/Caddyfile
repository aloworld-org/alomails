# Caddy fronts the HTTPS origin for alo. It does NOT obtain certificates
# here — the dedicated `certbot` service obtains and renews one Let's Encrypt
# certificate into the shared `certs` volume, and every service (Caddy, SMTP,
# IMAP) reads it from the same stable path /certs/live/<domain>/. Caddy just
# terminates TLS on 443, serves the web app, and reverse-proxies the API +
# OIDC paths to the internal JMAP service. See docker-compose.yml and README.md.

{
	# We manage certificates with certbot, not Caddy's own ACME — every site
	# below names its own fullchain.pem, and that keeps precedence. This is
	# `disable_redirects` rather than `off` because on-demand TLS is part of
	# Caddy's certificate machinery and `off` switches all of it away; the
	# redirects stay ours, in the explicit http:// blocks that also serve
	# certbot's renewal challenges.
	auto_https disable_redirects

	# alo Sites serves customer subdomains and customer domains, which cannot
	# be enumerated in a file — they are rows in a database that change while
	# this process is running. So their certificates are obtained on demand,
	# during the first handshake for a host.
	#
	# `ask` is what stops that being an open door: anyone can point a DNS name
	# at this address, and without it every one of them would make us request a
	# certificate. alo-sites answers 200 only for a host it actually serves.
	on_demand_tls {
		ask http://alo-sites:8082/internal/tls/ask
	}
}

# Plain HTTP (port 80): send every browser that types the bare domain on to
# HTTPS, so `mail.example.com` reaches the app instead of a dead port. The one
# exception is Let's Encrypt's HTTP-01 renewal probe: `certbot renew --webroot`
# (in the certbot service) writes the challenge token into the shared
# `acme_challenge` volume, mounted here read-only at /var/www/certbot, and we
# serve it as a static file. Caddy owns host port 80 for this; certbot no
# longer publishes it. auto_https is off, so this stays plain HTTP — Caddy
# won't try to get a cert for it or add its own redirect.
http://{$DOMAIN} {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# The one origin: the alo web app (SPA) plus the JMAP API + OIDC provider it
# talks to. The app and its backend share an origin, so there is no CORS and
# the login redirect stays first-party.
https://{$DOMAIN} {
	tls /certs/live/{$DOMAIN}/fullchain.pem /certs/live/{$DOMAIN}/privkey.pem
	encode zstd gzip

	# Backend paths: the JMAP API, the blob up/download + push, and every OIDC
	# endpoint (discovery, authorize, token, userinfo, jwks, revoke). Everything
	# else is the web app. `/auth/token` is backend; `/auth/callback` is a client
	# route (falls through to the SPA).
	#
	# `/mapi/*` stays in this list although the adapter is retired (ADR 0056).
	# It is not dead config: without it the path falls through to the web app,
	# and a client still configured for MAPI would be handed HTML with a 200
	# instead of a plain 404. Proxied, the backend answers "no such route",
	# which is the truth and the thing a client can act on.
	@backend path /api/* /jmap/* /mapi/* /oauth/* /auth/token /.well-known/* /dav /dav/* /autodiscover/* /Autodiscover/* /mail/config-v1.1.xml /wopi/* /signup/* /reset/*
	handle @backend {
		reverse_proxy alo-jmap:8080
	}


	# Desktop-app installers + a small download page (ADR 0005). Served from a
	# separate mount so a web deploy (which wipes /srv) never removes them.
	# `handle_path` strips the /download prefix: /download/alomails-...msi →
	# /srv/downloads/alomails-...msi, and /download/ → the download index.
	handle_path /download/* {
		root * /srv-downloads
		file_server
	}

	# Collabora Online (ADR 0010): the office editor bundle and its WOPI
	# discovery are served same-origin by proxying to the pinned engine
	# container. Must come BEFORE the SPA fallback, or /hosting/discovery is
	# swallowed by index.html and the Office editor can't find its URL.
	@collabora path /browser/* /cool/* /lool/* /hosting/*
	handle @collabora {
		reverse_proxy collabora:9980
	}

	# The web app: static files with client-side-routing fallback to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# A strict CSP: the app loads only its own code, styles, fonts, and
		# images, talks only to its own origin, and may not be framed. Inline
		# styles are allowed (component style attributes); scripts are not.
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
	}
}

# MTA-STS policy host (RFC 8461). Senders fetch
# https://mta-sts.<domain>/.well-known/mta-sts.txt. Covered by the same
# certificate (issued with both names as SANs — see init-certs.sh).
# DISABLED 2026-09-03, because it has never worked and now says so out loud.
#
# Two things are missing and both are required. The name
# mta-sts.mail.alomails.com has no DNS record at all (NXDOMAIN), and the
# certificate at /certs/live/mail.alomails.com carries exactly one SAN —
# mail.alomails.com — not the two the comment above claims. So no sending
# server has ever been able to fetch the policy, and MTA-STS is not in effect
# for this domain however good the file behind it is.
#
# It stayed invisible while auto_https off meant Caddy never checked a name
# against the certificate serving it. With certificate management enabled (for
# the on-demand hosts alo Sites needs) Caddy checked, found this name uncovered,
# and started asking Let us Encrypt for a certificate every sixty seconds for a
# host that does not resolve.
#
# To turn it back on, both halves are needed: an A record for mta-sts.<domain>,
# and that name added as a SAN in init-certs.sh so the certificate covers it.
# Until then this block can only fail, and failing quietly was the worse of the
# two options.
#
# https://mta-sts.{$DOMAIN} {
# 	tls /certs/live/{$DOMAIN}/fullchain.pem /certs/live/{$DOMAIN}/privkey.pem
# 	reverse_proxy alo-smtp:8461
# }

# ── Marketing landing site on the apex (alomails.com) ──────────────────────
# A separate static site: the app itself stays on mail.alomails.com, untouched.
# The apex has its OWN certbot certificate (init-landing.sh issues it into
# /certs/live/alomails.com/). These blocks must not be loaded until that cert
# exists, or Caddy fails to start the site — see the landing runbook in README.
http://alomails.com, http://www.alomails.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://alomails.com{uri} permanent
	}
}

# www → apex canonical.
https://www.alomails.com {
	tls /certs/live/alomails.com/fullchain.pem /certs/live/alomails.com/privkey.pem
	redir https://alomails.com{uri} permanent
}

https://alomails.com {
	tls /certs/live/alomails.com/fullchain.pem /certs/live/alomails.com/privkey.pem
	encode zstd gzip

	# **Autodiscover, on the apex, because that is where Outlook looks first.**
	#
	# Setting up mail for somebody@alomails.com, Outlook tries
	# https://alomails.com/autodiscover/autodiscover.xml before it tries
	# autodiscover.alomails.com, an HTTP redirect, or an SRV record. The apex is
	# the marketing site, so without this the first thing Outlook asks for is a
	# static page, and it ends up asking a person for a server name — which is
	# the whole thing ADR 0051 exists to remove.
	#
	# The `autodiscover.` hostname is deliberately *not* served: it resolves
	# here, but the certificate covers alomails.com and www only, so answering
	# on that name would need a certbot re-issue. Answering first is enough.
	#
	# Only these paths cross to the backend. The apex stays a static site for
	# everything else, and none of the mailbox API is reachable on it.
	@autodiscover path /autodiscover/* /Autodiscover/* /mail/config-v1.1.xml
	handle @autodiscover {
		reverse_proxy alo-jmap:8080
	}

	# The same installer downloads served on mail.alomails.com/download (one
	# shared directory), so the landing page's buttons work on the apex too.
	handle_path /download/* {
		root * /srv-downloads
		file_server
	}

	# The static marketing site.
	handle {
		root * /srv-landing
		file_server
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
	}
}

# ── aloworkplace.com — landing page (apex) + the workspace app (app subdomain) ──
# Same split as alomails: the apex aloworkplace.com is a static marketing landing
# (/srv-workplace-landing), the workspace app (all products, one login) lives at
# app.aloworkplace.com (/srv-workplace) and talks to the shared alo-jmap
# same-origin so login stays first-party. ONE certbot cert covers all three names
# (aloworkplace.com + www + app as SANs, in /certs/live/aloworkplace.com/). These
# blocks must NOT load until that cert exists — bring app online + expand the
# cert with init-workplace-app.sh (seed already done for the apex).
http://aloworkplace.com, http://www.aloworkplace.com, http://app.aloworkplace.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# www → apex canonical.
https://www.aloworkplace.com {
	tls /certs/live/aloworkplace.com/fullchain.pem /certs/live/aloworkplace.com/privkey.pem
	redir https://aloworkplace.com{uri} permanent
}

# The apex: the static marketing landing (its own repo, aloworkplace-website).
https://aloworkplace.com {
	tls /certs/live/aloworkplace.com/fullchain.pem /certs/live/aloworkplace.com/privkey.pem
	encode zstd gzip

	handle_path /download/* {
		root * /srv-downloads
		file_server
	}

	handle {
		root * /srv-workplace-landing
		file_server
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
	}
}

# app.aloworkplace.com: the workspace app (all products, one login). Same cert as
# the apex (app is a SAN). Same backend paths as mail, same-origin.
https://app.aloworkplace.com {
	tls /certs/live/aloworkplace.com/fullchain.pem /certs/live/aloworkplace.com/privkey.pem
	encode zstd gzip

	@backend path /api/* /jmap/* /mapi/* /oauth/* /auth/token /.well-known/* /dav /dav/* /autodiscover/* /Autodiscover/* /mail/config-v1.1.xml /wopi/* /signup/* /reset/*
	handle @backend {
		reverse_proxy alo-jmap:8080
	}


	handle_path /download/* {
		root * /srv-downloads
		file_server
	}

	# Collabora Online (office editor): its assets + websocket editing traffic,
	# same-origin so the app can embed it without CSP/CORS friction.
	@collabora path /browser/* /cool/* /lool/* /hosting/*
	handle @collabora {
		reverse_proxy collabora:9980
	}

	# The workspace SPA (a separate build from the mail app).
	handle {
		root * /srv-workplace
		try_files {path} /index.html
		file_server
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
	}
}

