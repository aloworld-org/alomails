# ---------------------------------------------------------------------------
# alo Sites: the public, anonymous side. The apex and every customer subdomain
# on the wildcard; customer custom domains arrive here too, once their owner
# has pointed DNS at this address and alo-sites recognises the host.
# ---------------------------------------------------------------------------

http://alosites.com, http://*.alosites.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Deliberately a catch-all rather than `alosites.com, *.alosites.com`.
#
# Naming the wildcard makes Caddy try to obtain a *wildcard* certificate, and a
# wildcard can only be issued over DNS-01 — which needs API credentials for the
# nameservers that this deployment does not have. Every certificate here comes
# from HTTP-01.
#
# So the address is left open and the decision is moved to `ask`: any host that
# reaches this machine and is not claimed by a block above arrives here, and
# alo-sites answers whether it is a site we actually serve. That is also what
# makes customer custom domains work without an entry in this file — they are
# rows in a database, and this file cannot know them.
#
# A host nobody configured gets a 404 from the ask endpoint, no certificate is
# requested, and the handshake fails exactly as it did before any of this
# existed.
https:// {
	tls {
		on_demand
	}
	reverse_proxy alo-sites:8082
}
